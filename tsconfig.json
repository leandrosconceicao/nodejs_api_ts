{
    "compilerOptions": {
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "module": "node16",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "es6",
        "noImplicitAny": true,
        "moduleResolution": "node16",
        "sourceMap": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./build",
        "lib": [
          "ES2021.String",
          "dom"
        ],
        "baseUrl": "./src",
        "typeRoots" : [
            "./src/types",
            "./node_modules/@types"
        ],
        "paths": {
            "*": [
                "node_modules/*"
            ],
            "@src/*": ["src/*"]
        }
    },
    "include": [
        "src"
    ]
}